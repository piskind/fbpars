POSTGRES_USER=spy
POSTGRES_PASSWORD=spy_change_me
POSTGRES_DB=spy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://spy:spy_change_me@postgres:5432/spy

PROXY_TYPE=socks5
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
PROXY_ROTATE_URL=
PROXY_ROTATE_WAIT_SEC=20

# ── Proxy provider (Phase 3) — PLACEHOLDERS, fill when pool is bought ──
# PROXY_MODE=rotate_url  → single mobile channel via gost + PROXY_ROTATE_URL (current)
# PROXY_MODE=pool        → residential pool, one IP per request
PROXY_MODE=rotate_url
# JSON list of "host:port:user:pass" entries; leave [] to load from `proxies` DB table
PROXY_POOL=[]
PROXY_POOL_FROM_DB=true
ROTATE_EVERY_N_REQUESTS=1

# ── Pagination (Phase 1) ──
# PAGINATION_MODE=auto|curl|browser  (auto = curl_cffi, browser fallback on rate limit)
PAGINATION_MODE=auto
CURL_IMPERSONATE=chrome131
SESSION_REFRESH_EVERY=50
TOKEN_BROWSER_CONCURRENCY=2

# ── Queue / workers (Phase 2) ──
REDIS_URL=redis://spy_redis:6379/0
USE_QUEUE=true
CHUNK_DAYS=1
PARSER_WORKERS=4
# MEDIA_WORKERS controls the Phase 4 media-worker replica count
MEDIA_WORKERS=2

# ── Media pipeline (Phase 4) ──
# Skip video downloads on the first pass (heaviest traffic; server has a transfer cap)
SKIP_VIDEO_FIRST_PASS=true

S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-1

LOG_LEVEL=INFO
HEADLESS=true
SCROLL_MAX_ATTEMPTS=50
SCROLL_PAUSE_SEC=2

FRONTEND_BASE_URL=https://spyon.top
RESEND_API_KEY=
DEBUG=false

JWT_SECRET=
